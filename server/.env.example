# Copy to .env and fill in. Never commit the real .env file.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/smart-expense-tracker
# Long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d
# Comma-separated list of allowed browser origins (the React dev server)
CORS_ORIGIN=http://localhost:5173
