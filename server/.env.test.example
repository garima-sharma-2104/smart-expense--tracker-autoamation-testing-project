# Isolated configuration for automated tests (copy to .env.test).
# The database name MUST end with "-test"; scripts/cleanTestDb.js refuses anything else.
PORT=5000
NODE_ENV=test
MONGO_URI=mongodb://127.0.0.1:27017/smart-expense-tracker-test
JWT_SECRET=test-only-secret-change-me
JWT_EXPIRE=1d
CORS_ORIGIN=http://localhost:5173
