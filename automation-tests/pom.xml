<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.smartexpense</groupId>
  <artifactId>automation-tests</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Smart Expense Tracker - Selenium UI Automation</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <selenium.version>4.27.0</selenium.version>
    <testng.version>7.10.2</testng.version>
    <jackson.version>2.17.2</jackson.version>
    <surefire.version>3.5.2</surefire.version>
    <suiteXmlFile>testng.xml</suiteXmlFile>
    <!-- Empty defaults: unset values fall back to environment variables / test.properties -->
    <BASE_URL></BASE_URL>
    <API_URL></API_URL>
    <BROWSER></BROWSER>
    <HEADLESS></HEADLESS>
  </properties>

  <dependencies>
    <!-- Selenium WebDriver (Selenium Manager downloads the browser driver automatically) -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- JSON handling for the REST helper used to seed test data -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <suiteXmlFiles>
            <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
          </suiteXmlFiles>
          <!-- Pass -DBASE_URL, -DAPI_URL, -DBROWSER, -DHEADLESS ... through to the test JVM -->
          <systemPropertyVariables>
            <BASE_URL>${BASE_URL}</BASE_URL>
            <API_URL>${API_URL}</API_URL>
            <BROWSER>${BROWSER}</BROWSER>
            <HEADLESS>${HEADLESS}</HEADLESS>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
